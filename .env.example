# Copy to .env for local development. Never commit .env.

APP_ENV=development              # production on the live server
APP_NAME=Trip Reports            # the product name shown everywhere; rename here
APP_URL=http://localhost:8000
SECRET_KEY=                      # required in production; any long random string
DATABASE_URL=sqlite:///./tripreports.db   # Postgres in production

# Photos and logos: local (folder), db (inside Postgres, simplest for free hosting) or s3 (S3/R2)
STORAGE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                 # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= are read by boto3 when STORAGE=s3

# Stripe (use test-mode keys until you go live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
TRIAL_DAYS=14

# AI that reads messy notes, fixes spelling and drafts reports. Without a key the free parser
# and drafter are used. Free option: create a key at console.groq.com and put it in LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible provider works
LLM_MODEL=openai/gpt-oss-120b                 # comma-separate several to try in order; retired ones are skipped
# Or Claude, if you later want the strongest writing (paid). It takes priority when set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Optional: email for password resets and invites (links are shown on screen without it)
# Email: Brevo's free HTTP API (needed on Render's free tier, which blocks SMTP), or plain SMTP
BREVO_API_KEY=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Species name checks against GBIF (free)
GBIF_CHECK=true

# Shown on the privacy and terms pages
SUPPORT_EMAIL=
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_ID=
# Login emails that can open /app/admin to turn on free pilot accounts (comma separated)
ADMIN_EMAILS=
